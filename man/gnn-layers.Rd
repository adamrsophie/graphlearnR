   \code{gat_conv} \tab \eqn{\sum_j \alpha_{ij} W x_j}, \eqn{\alpha} from \eqn{a^\top [W x_i \Vert W x_j]} \tab \code{edge_attr} \tab replaced: existing removed, one per node added \cr
   \code{gatv2_conv} \tab \eqn{\sum_j \alpha_{ij} W_s x_j}, \eqn{\alpha} from \eqn{a^\top \mathrm{LeakyReLU}(W_s x_j + W_t x_i)} \tab \code{edge_attr} \tab as \code{gat_conv} \cr
